# Copy to private .env (chmod 600); replace placeholder, never commit secrets.
AMB_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
AMB_PUBLIC_ORIGIN=https://board.example.com
AMB_DATABASE_PATH=/data/board.sqlite
PORT=3000
AMB_HOST_PORT=3000
AMB_IMAGE_TAG=latest
# Only set true with an explicitly configured localhost HTTP origin for development.
AMB_DEV_HTTP=false
